# SQLite by default - works with zero setup.
# For production, swap to Postgres, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/veyra"
DATABASE_URL="file:./dev.db"

# Any long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Optional: only needed if you later wire up a real LLM for the AI Advisor.
# Without this, VEYRA uses its built-in rule-based advisor (fully functional, no key needed).
AI_API_KEY=""
